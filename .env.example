# Copia este archivo a ".env" (mismo directorio) y ajusta los valores.
# ".env" nunca debe subirse al repositorio (ver .gitignore).

MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=opc_inventario
MYSQL_USER=opc_app
MYSQL_PASSWORD=changeme_app
MYSQL_PORT=3306

# Backend (Spring Boot)
BACKEND_PORT=8080
JWT_SECRET=changeme_jwt_secret_largo_y_aleatorio
JWT_EXPIRATION=86400000
SHOW_SQL=false
