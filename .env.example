# Copia este archivo a ".env" (mismo directorio) y ajusta los valores.
# ".env" nunca debe subirse al repositorio (ver .gitignore).

MYSQL_ROOT_PASSWORD=admin_root
MYSQL_DATABASE=opc_inventario
MYSQL_USER=opc_app
MYSQL_PASSWORD=admin
MYSQL_PORT=3307

# Backend (Spring Boot)
BACKEND_PORT=8080
# Zona horaria del contenedor — sin esto corre en UTC y toda fecha/hora
# calculada en el servidor (LocalDateTime.now()) queda desfasada respecto
# a la hora local del negocio.
APP_TIMEZONE=America/Bogota
JWT_SECRET=changeme_jwt_secret_largo_y_aleatorio
# Access token de vida corta (15 min) + refresh token persistido y rotado
# (7 días) — ver ADR-003 en requirements/Decisiones_Arquitectura.md.
JWT_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=604800000
SHOW_SQL=false
# Orígenes del frontend permitidos por CORS (separados por coma) — deben
# coincidir con las URLs reales desde donde el navegador llama a la API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (React, servido por nginx)
FRONTEND_PORT=3000
# Debe apuntar al puerto donde el navegador puede alcanzar el backend
# (BACKEND_PORT de arriba) — si cambias BACKEND_PORT, actualiza esto también.
VITE_API_BASE_URL=http://localhost:8080
